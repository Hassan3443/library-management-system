@startuml
!include _style.iuml
title Library Management System: Borrow Request Sequence Diagram (FR-04, FR-05, FR-14)
skinparam sequenceMessageAlign center
autonumber "<b>00"

actor "Library Member" as M
participant "m : Member" as MO
participant ":Book" as B
participant ":BookCopy" as C
participant ":Loan" as L
participant "l : Librarian" as LO
actor "Librarian (person)" as LB

M -> MO : viewBookDetails(book)  (FR-04)
activate MO
MO -> B : getAvailableCopies()
activate B
B --> MO : available copies
deactivate B
MO --> M : details + availability
deactivate MO

M -> MO : requestBorrow(book)  (FR-05)
activate MO
MO -> MO : hasUnpaidFines()
MO -> MO : countActiveLoans() + pending requests (limit 3)
MO -> B : findAvailableCopy()
B --> MO : copy / none
alt member eligible and copy available
  MO -> L ** : <<create>> new Loan(member, book)
  activate L
  L -> L : status = PENDING
  L --> MO : loan (PENDING)
  deactivate L
  MO ->> LO : new pending request
  MO --> M : request submitted
else not eligible (suspended, unpaid fine, limit 3 reached) or no copy available
  MO --> M : request rejected with reason
end
deactivate MO

... Later: Librarian reviews pending request ...

LB -> LO : confirmBorrowRequest(loan)  (FR-14)
activate LO
LO -> LO : re-check member and copy
alt approved and re-check passed
  LO -> L : approve(dueDate = today + 14 days)
  activate L
  L --> LO : status ACTIVE
  deactivate L
  LO -> C : markOnLoan()
  activate C
  C --> LO : status = ON_LOAN
  deactivate C
  LO ->> M : loan confirmed with due date
else rejected or re-check failed
  LO -> L : reject(reason)  (rejectBorrowRequest)
  activate L
  L --> LO : status REJECTED
  deactivate L
  LO ->> M : request rejected with reason
end
deactivate LO

note over M, LB
  Return (FR-08 initiateReturn, FR-15 processReturn, FR-16 fine)
  is shown in the Activity diagram.
end note
@enduml
