digraph DFD1 {
  graph [rankdir=LR, splines=true, nodesep=0.45, ranksep=1.3, newrank=true, fontname="Helvetica", labelloc=t, fontsize=26, label="Library Management System: Data Flow Diagram, Level 1
", dpi=100, pad=0.6, margin=0.2, bgcolor=white];
  node [fontname="Helvetica", fontsize=15];
  edge [fontname="Helvetica", fontsize=13, color="#334155", fontcolor="#1e293b", arrowsize=0.7];

  M [label="Library Member", shape=box, style="filled,bold", fillcolor="#fde68a", color="#92400e", margin="0.25,0.18"];
  L [label="Librarian", shape=box, style="filled,bold", fillcolor="#fde68a", color="#92400e", margin="0.25,0.18"];

  node [shape=circle, style=filled, fillcolor="#dbeafe", color="#1d4ed8", width=2.0, fixedsize=true, fontsize=15];
  P1 [label="1.0\nRegister and\nAuthenticate"];
  P2 [label="2.0\nSearch and\nView Books"];
  P3 [label="3.0\nManage Borrow\nRequests"];
  P4 [label="4.0\nProcess Loans\nand Returns"];
  P5 [label="5.0\nTrack Overdue\nand Fines"];
  P6 [label="6.0\nManage\nReservations"];
  P7 [label="7.0\nManage Catalog\nand Copies"];
  P8 [label="8.0\nManage Member\nAccounts"];

  node [shape=none, fixedsize=false, fontsize=15];
  D1 [shape=none, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD SIDES="LTB" BORDER="2" BGCOLOR="#f1f5f9" CELLPADDING="9"><FONT POINT-SIZE="15">D1   Books</FONT></TD></TR></TABLE>>];
  D2 [shape=none, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD SIDES="LTB" BORDER="2" BGCOLOR="#f1f5f9" CELLPADDING="9"><FONT POINT-SIZE="15">D2   Book Copies</FONT></TD></TR></TABLE>>];
  D3 [shape=none, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD SIDES="LTB" BORDER="2" BGCOLOR="#f1f5f9" CELLPADDING="9"><FONT POINT-SIZE="15">D3   Members</FONT></TD></TR></TABLE>>];
  D4 [shape=none, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD SIDES="LTB" BORDER="2" BGCOLOR="#f1f5f9" CELLPADDING="9"><FONT POINT-SIZE="15">D4   Loans</FONT></TD></TR></TABLE>>];
  D5 [shape=none, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD SIDES="LTB" BORDER="2" BGCOLOR="#f1f5f9" CELLPADDING="9"><FONT POINT-SIZE="15">D5   Fines</FONT></TD></TR></TABLE>>];
  D6 [shape=none, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD SIDES="LTB" BORDER="2" BGCOLOR="#f1f5f9" CELLPADDING="9"><FONT POINT-SIZE="15">D6   Reservations</FONT></TD></TR></TABLE>>];
  D7 [shape=none, margin=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD SIDES="LTB" BORDER="2" BGCOLOR="#f1f5f9" CELLPADDING="9"><FONT POINT-SIZE="15">D7   Notifications</FONT></TD></TR></TABLE>>];

  {rank=min; M}
  {rank=max; L}
  M -> P1 [label="registration / login details"];
  P1 -> M [label="login result"];
  P1 -> D3 [label="new member record"];
  D3 -> P1 [label="credentials"];
  L -> P1 [label="login details"];
  P1 -> L [label="login result"];

  M -> P2 [label="search criteria"];
  P2 -> M [label="book details +\navailability"];
  D1 -> P2 [label="book data"];
  D2 -> P2 [label="copy status"];

  M -> P3 [label="borrow request"];
  P3 -> M [label="request status"];
  D3 -> P3 [label="member status"];
  D2 -> P3 [label="copy availability"];
  D5 -> P3 [label="unpaid fines"];
  D4 -> P3 [label="active loans"];
  P3 -> D4 [label="pending request"];
  P3 -> L [label="pending requests"];
  L -> P3 [label="confirmation or rejection"];
  P3 -> P4 [label="approved request"];

  P4 -> D4 [label="loan record"];
  D4 -> P4 [label="loan, due date"];
  P4 -> D2 [label="copy status update"];
  M -> P4 [label="return initiation"];
  L -> P4 [label="return confirmation"];
  P4 -> P5 [label="returned loan"];
  P4 -> M [label="current loans and\nborrowing history"];
  P4 -> P6 [label="copy returned"];

  D4 -> P5 [label="loans, due dates"];
  P5 -> D5 [label="fine record"];
  P5 -> D7 [label="overdue /\ndue-date notice"];
  P5 -> L [label="overdue report"];
  P5 -> M [label="due-date /\noverdue notice"];
  P5 -> M [label="fines"];
  D5 -> P5 [label="fine history"];

  M -> P6 [label="reservation request"];
  P6 -> M [label="queue position"];
  P6 -> D6 [label="queue entry"];
  D6 -> P6 [label="waiting queue"];
  P6 -> D7 [label="availability notice"];
  D7 -> P6 [label="stored notices"];
  P6 -> M [label="notifications"];
  L -> P6 [label="reservation queue request"];
  P6 -> L [label="reservation queues"];

  L -> P7 [label="book / copy changes"];
  P7 -> D1 [label="catalog updates"];
  P7 -> D2 [label="copy updates"];

  L -> P8 [label="member account actions\n(view, suspension, promotion,\nremoval)"];
  P8 -> D3 [label="account status, role,\nmember removal"];
  D4 -> P8 [label="active loans"];
  P8 -> D4 [label="removed member's\nloan deletion"];
  P8 -> D6 [label="removed member's\nreservation deletion"];
  D5 -> P8 [label="unpaid fines"];
  P8 -> L [label="member list"];
  D3 -> P8 [label="member records"];
}
