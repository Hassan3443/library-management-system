@startuml
!include _style.iuml
title Library Management System: Use Case Diagram
left to right direction
skinparam nodesep 12
skinparam ranksep 90

actor "Library Member" as M
actor "Librarian" as L

rectangle "Library Management System" {
  package "Account" {
    usecase "UC1 Register\n(FR-01)" as UC1
    usecase "UC2 Log in / Log out\n(FR-02)" as UC2
  }
  package "Browse and Borrow" {
    usecase "UC3 Search books\n(FR-03)" as UC3
    usecase "UC4 View book details\nand availability (FR-04)" as UC4
    usecase "UC5 Submit borrow request\n(FR-05)" as UC5
    usecase "UC6 View current loans\n(FR-06)" as UC6
    usecase "UC7 View borrowing history\n(FR-07)" as UC7
    usecase "UC8 Initiate return\n(FR-08)" as UC8
    usecase "UC9 Reserve a book on loan\n(FR-09)" as UC9
    usecase "UC10 View outstanding fines\n(FR-10)" as UC10
    usecase "UC11 Receive due-date\nnotifications (FR-11)" as UC11
  }
  package "Library Administration" {
    usecase "UC12 Manage catalog\n(FR-12)" as UC12
    usecase "UC13 Manage book copies\n(FR-13)" as UC13
    usecase "UC14 Confirm borrow request\nand issue loan (FR-14)" as UC14
    usecase "UC15 Process return\n(FR-15)" as UC15
    usecase "UC16 Calculate overdue fine\n(FR-16)" as UC16
    usecase "UC17 Manage member accounts\n(FR-17)" as UC17
    usecase "UC18 Manage reservation queue\n(FR-18)" as UC18
  }
}

M --> UC1
M --> UC2
M --> UC3
M --> UC5
M --> UC6
M --> UC7
M --> UC8
M --> UC9
M --> UC10
M --> UC11
UC2 <-- L
UC12 <-- L
UC13 <-- L
UC14 <-- L
UC15 <-- L
UC17 <-- L
UC18 <-- L

UC3 .> UC4 : <<include>>
UC5 .> UC4 : <<include>>
UC15 .> UC16 : <<include>>
@enduml
