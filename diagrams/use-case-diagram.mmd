flowchart LR
    M([Library Member])
    L([Librarian])

    subgraph System[Library Management System]
        UC1(Register / Log in)
        UC2(Search books by title, author, category)
        UC3(View book details and availability)
        UC4(Submit borrow request)
        UC5(View current loans and due dates)
        UC6(View borrowing history)
        UC7(Initiate book return)
        UC8(Reserve a book on loan)
        UC9(View outstanding fines)
        UC10(Receive due-date and overdue notifications)
        UC11(Manage books in catalog)
        UC12(Manage book copies)
        UC13(Confirm borrow requests and issue loans)
        UC14(Process returns and update availability)
        UC15(Identify overdue loans and calculate fines)
        UC16(Manage member accounts)
        UC17(Manage reservation queue)
    end

