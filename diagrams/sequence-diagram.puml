@startuml
!include _style.iuml
title Library Management System: Borrow Request Sequence Diagram (FR-05, FR-14)
skinparam sequenceMessageAlign center
autonumber "<b>00"

actor "Member" as M
participant ":Member" as MO
participant ":Book" as B
participant ":BookCopy" as C
participant ":Loan" as L
participant ":Fine" as F
actor "Librarian" as LB

M -> B : viewBookDetails(book)  (FR-04)
activate B
B -> B : getAvailableCopies()
B --> M : details + availability
deactivate B

M -> MO : requestBorrow(book)  (FR-05)
activate MO
MO -> L : create Loan(member, book)
activate L
L -> F : unpaid fines for member?
F --> L : none / unpaid
L -> L : count member's active loans (limit 3)
alt member eligible and a copy is available
  L -> C : find an AVAILABLE copy
  C --> L : copy
  L -> L : status = PENDING
  L --> MO : loan (PENDING)
  MO --> M : request submitted
  L --> LB : new pending request
  deactivate L
  LB -> L : confirmBorrowRequest(loan)  (FR-14)
  activate L
  L -> L : borrowDate = today, dueDate = +14 days
  L -> L : status = ACTIVE
  L -> C : markOnLoan()
  C --> L : status = ON_LOAN
  L --> M : loan confirmed with due date
else not eligible (unpaid fine or 3 active loans) or no copy available
  L --> MO : rejected with reason
  MO --> M : request rejected with reason
end
deactivate L
deactivate MO

note over M, LB
  Return (FR-08 initiateReturn, FR-15 processReturn, FR-16 fine)
  is shown in the Activity diagram.
end note
@enduml
