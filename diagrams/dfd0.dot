digraph DFD0 {
  graph [rankdir=TB, nodesep=1.2, ranksep=1.6, fontname="Helvetica", labelloc=t, fontsize=20, label="Library Management System: Context Diagram (DFD Level 0)\n", dpi=150, pad=0.7, margin=0.3, bgcolor=white];
  node [fontname="Helvetica", fontsize=15];
  edge [fontname="Helvetica", fontsize=15, color="#334155", fontcolor="#1e293b", arrowsize=0.75];
  M [label="Library Member", shape=box, style="filled,bold", fillcolor="#fde68a", color="#92400e", margin="0.3,0.25"];
  L [label="Librarian", shape=box, style="filled,bold", fillcolor="#fde68a", color="#92400e", margin="0.3,0.25"];
  S [label="0\nLibrary\nManagement\nSystem", shape=circle, style=filled, fillcolor="#dbeafe", color="#1d4ed8", width=2.2, fixedsize=true, fontsize=18];
  M -> S [label="registration / login details, search criteria,\nborrow request, return initiation,\nreservation request / cancellation"];
  S -> M [label="login result, book details + availability,\nrequest status, current loans and borrowing history,\nfines, notifications, queue position"];
  L -> S [label="login details, book / copy changes,\nconfirmation or rejection, return confirmation,\nmember account actions, fine payment,\nreservation queue request"];
  S -> L [label="login result, pending requests, overdue report,\nmember list, reservation queues"];
}
