@startuml
!include _style.iuml
title Library Management System: Borrow Request Sequence Diagram (FR-05, FR-14)
skinparam sequenceMessageAlign center
autonumber "<b>00"

actor "Member" as M
participant ":Member" as MO
participant ":Book" as B
participant ":BookCopy" as C
participant ":Loan" as L
participant ":Fine" as F
participant ":Librarian" as LO
actor "Librarian" as LB

M -> MO : viewBookDetails(book)  (FR-04)
activate MO
MO -> B : getAvailableCopies()
activate B
B --> MO : available copies
deactivate B
MO --> M : details + availability
deactivate MO

M -> MO : requestBorrow(book)  (FR-05)
activate MO
MO -> MO : check account active
MO -> F : unpaid fines for member?
F --> MO : none / unpaid
MO -> MO : count active loans (limit 3)
MO -> C : find an AVAILABLE copy
C --> MO : copy / none
alt member eligible and copy available
  MO -> L ** : <<create>> Loan(member, copy)
  activate L
  L -> L : status = PENDING
  L --> MO : loan (PENDING)
  deactivate L
  MO --> M : request submitted
  deactivate MO
  MO ->> LO : new pending request
else not eligible (inactive account, unpaid fine, 3 active loans) or no copy available
  activate MO
  MO --> M : request rejected with reason
  deactivate MO
end

... Later: Librarian reviews pending request ...

LB -> LO : confirmBorrowRequest(loan)  (FR-14)
activate LO
alt approved
  LO -> L : borrowDate = today, dueDate = +14 days
  activate L
  LO -> L : status = ACTIVE
  deactivate L
  LO -> C : markOnLoan()
  activate C
  C --> LO : status = ON_LOAN
  deactivate C
  LO ->> M : loan confirmed with due date
else rejected
  LO -> L : status = REJECTED
  activate L
  deactivate L
  LO ->> M : request rejected with reason
end
deactivate LO

note over M, LB
  Return (FR-08 initiateReturn, FR-15 processReturn, FR-16 fine)
  is shown in the Activity diagram.
end note
@enduml
