@startuml
!include _style.iuml
title Library Management System: Class Diagram
hide empty members
skinparam linetype ortho

enum Role <<enumeration>> {
  MEMBER
  LIBRARIAN
}
enum CopyStatus <<enumeration>> {
  AVAILABLE
  ON_LOAN
  RESERVED
  MAINTENANCE
}
enum LoanStatus <<enumeration>> {
  PENDING
  ACTIVE
  RETURNED
  REJECTED
}
enum ReservationStatus <<enumeration>> {
  WAITING
  NOTIFIED
  FULFILLED
  CANCELLED
}

class Book {
  - bookId : int
  - title : String
  - author : String
  - category : String
  - isbn : String
  - publicationYear : int
  --
  + addCopy(copy : BookCopy)
  + removeCopy(copy : BookCopy)
  + getAvailableCopies() : int
  + findAvailableCopy() : BookCopy
  + updateDetails()
}
class BookCopy {
  - copyId : String
  - status : CopyStatus
  - location : String
  --
  + markAvailable()
  + markOnLoan()
  + markReserved()
  + markMaintenance()
}
abstract class User {
  # userId : int
  # name : String
  # email : String
  # password : String
  # role : Role
  --
  + login(email : String, password : String) : boolean  <<FR-02>>
  + logout()                <<FR-02>>
}
class Member {
  - joinDate : Date
  - isActive : boolean
  --
  + {static} register(name : String, email : String, password : String)  <<FR-01>>
  + searchBooks(criteria : String) : List  <<FR-03>>
  + viewBookDetails(book : Book) : Book  <<FR-04>>
  + requestBorrow(book : Book) : Loan        <<FR-05>>
  + viewCurrentLoans() : List                <<FR-06>>
  + viewHistory() : List                     <<FR-07>>
  + initiateReturn(loan : Loan)              <<FR-08>>
  + reserve(book : Book) : Reservation       <<FR-09>>
  + cancelReservation(r : Reservation)       <<FR-09>>
  + viewFines() : List                       <<FR-10>>
  + receiveNotification() : Notification     <<FR-11>>
  + hasUnpaidFines() : boolean
  + countActiveLoans() : int
}
class Librarian {
  --
  + addBook(book : Book)                     <<FR-12>>
  + updateBook(book : Book)                  <<FR-12>>
  + removeBook(bookId : int)                 <<FR-12>>
  + manageCopy(copy : BookCopy, s : CopyStatus) <<FR-13>>
  + setCopyCount(book : Book, total : int)   <<FR-13>>
  + confirmBorrowRequest(loan : Loan)        <<FR-14>>
  + rejectBorrowRequest(loan : Loan, reason : String)  <<FR-14>>
  + processReturn(loan : Loan)               <<FR-15>>
  + identifyOverdueLoans() : List            <<FR-16>>
  + calculateFine(loan : Loan) : Fine        <<FR-16>>
  + recordFinePayment(fine : Fine)           <<FR-10>>
  + viewMembers() : List                     <<FR-17>>
  + suspendMember(member : Member)           <<FR-17>>
  + promoteMember(member : Member)           <<FR-17>>
  + removeMember(member : Member)            <<FR-19>>
  + viewReservationQueue(book : Book) : List <<FR-18>>
  + notifyNextMember(book : Book)            <<FR-18>>
}
class Notification {
  - notificationId : int
  - type : String
  - message : String
  - sentAt : Date
  --
  + send()
}
class Loan {
  - loanId : int
  - borrowDate : Date
  - dueDate : Date
  - returnDate : Date
  - status : LoanStatus
  --
  + approve(dueDate : Date)
  + reject(reason : String)
  + isOverdue() : boolean
  + isDueSoon() : boolean
  + daysOverdue() : int
  + close()
}
class Fine {
  - fineId : int
  - amount : int
  - overdueDays : int
  - isPaid : boolean
  --
  + markPaid()
}
class Reservation {
  - reservationId : int
  - reservationDate : Date
  - queuePosition : int
  - status : ReservationStatus
  --
  + notifyMember()
  + cancel()
}

User <|-- Member
User <|-- Librarian
Member "1" -- "0..*" Notification : receives
Book "1" *-- "0..*" BookCopy : has copies
Member "1" -- "0..*" Loan : borrows
BookCopy "1" -- "0..*" Loan : lent in
Librarian "0..1" -- "0..*" Loan : confirms / processes
Librarian ..> Book : manages
Librarian ..> BookCopy : manages
Librarian ..> Member : manages
Librarian ..> Reservation : manages
Loan "1" -- "0..1" Fine : may incur
Member "1" -- "0..*" Fine : owes
Member "1" -- "0..*" Reservation : places
Book "1" -- "0..*" Reservation : reserved for

note right of Librarian
  FR-16 "automatically": identifyOverdueLoans() is a
  scheduled check run on behalf of the librarian role
  (the system triggers it, no manual action needed).
end note

note bottom of Reservation
  A reservation is for a book. When a copy comes back and
  a queue exists, the returned copy is set to RESERVED
  (held for the first member in the queue).
end note

note bottom of Fine
  Business rules: 5 EGP per overdue day.
  Loan period: 14 days.
  Max 3 = active loans + pending requests.
  Overdue is derived from dueDate (not stored).
  promoteMember sets User.role to LIBRARIAN.
end note
@enduml
