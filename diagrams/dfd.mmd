flowchart LR
    M([Library Member])
    L([Librarian])

    P1["1.0<br/>Search and Browse Books"]
    P2["2.0<br/>Manage Borrow Requests"]
    P3["3.0<br/>Process Loans and Returns"]
    P4["4.0<br/>Track Overdue and Fines"]
    P5["5.0<br/>Manage Catalog and Members"]
    P6["6.0<br/>Manage Reservations"]

    D1[("D1 Books")]
    D2[("D2 Book Copies")]
    D3[("D3 Members")]
    D4[("D4 Loans")]
    D5[("D5 Fines")]
    D6[("D6 Reservations")]

    M -- "search criteria" --> P1
    P1 -- "book details + availability" --> M
    P1 <-- "book, copy data" --> D1
    P1 <-- "copy status" --> D2

    M -- "borrow request" --> P2
    P2 -- "request status" --> M
    P2 <-- "member eligibility" --> D3
    L -- "confirm / reject" --> P2
    P2 -- "approved loan" --> D4
    P2 -- "copy = On Loan" --> D2

    M -- "returned book" --> P3
    L -- "return confirmation" --> P3
    P3 <-- "loan record" --> D4
    P3 -- "copy = Available" --> D2
    P3 -- "overdue loan" --> P4

    P4 -- "fine amount" --> D5
    P4 <-- "loans, due dates" --> D4
    P4 -- "overdue notice, fine details" --> M
    P4 -- "overdue report" --> L

    L -- "book and copy changes" --> P5
    P5 -- "catalog updates" --> D1
    P5 -- "copy updates" --> D2
    L -- "member actions" --> P5
    P5 <-- "member records" --> D3

    M -- "reservation request" --> P6
    P6 -- "queue position" --> M
    P6 <-- "reservation queue" --> D6
    P3 -- "copy returned" --> P6
    P6 -- "availability notice" --> M
